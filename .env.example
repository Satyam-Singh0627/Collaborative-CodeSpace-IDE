# Environment Configuration Template (DO NOT put real secrets here)
# Copy this to .env (or backend/.env) for local development

# ==============================================================================
# Application & Deployment Settings
# ==============================================================================
ENVIRONMENT=development
PORT=8000

# CORS / Allowed Frontend URLs:
# Set this to your production Vercel frontend URL on Render (e.g., https://your-app.vercel.app)
# Supports comma-separated origins: https://your-app.vercel.app,https://yourcustomdomain.com
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Database Configuration
# ==============================================================================
# Local development uses SQLite; Production on Render can use PostgreSQL (DATABASE_URL=postgresql://...)
DATABASE_URL=sqlite:///./codespace.db

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# AI Coding Assistant Configuration
# ==============================================================================
# Provide either an OpenRouter key (sk-or-v1-...) or Google Gemini key
OPENROUTER_API_KEY=
GEMINI_API_KEY=
AI_API_KEY=
AI_PROVIDER=auto
AI_MODEL=openai/gpt-4o-mini

# ==============================================================================
# Code Execution Sandbox
# ==============================================================================
# Providers: 'local' (built-in isolated sandbox), 'piston', 'judge0', or 'auto'
EXECUTION_PROVIDER=local
PISTON_API_URL=https://emkc.org/api/v2/piston
JUDGE0_API_URL=https://ce.judge0.com/submissions?wait=true&base64_encoded=true

# ==============================================================================
# Video & Voice Collaboration
# ==============================================================================
STUN_SERVER=stun:stun.l.google.com:19302
