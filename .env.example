# Environment Configuration Placeholder (DO NOT put real secrets here)
# Copy to .env for local development

# Application
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (Default uses local SQLite in backend directory)
DATABASE_URL=sqlite:///./codespace.db

# Authentication / JWT
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Coding Assistant (Optional: Gemini API Key)
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash

# Code Execution (Piston API — public sandbox, no key required)
PISTON_API_URL=https://emkc.org/api/v2/piston

# Video Collaboration (Optional WebRTC / STUN / TURN servers)
STUN_SERVER=stun:stun.l.google.com:19302
