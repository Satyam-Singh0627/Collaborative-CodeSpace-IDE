# Backend Environment Configuration Template (DO NOT put real secrets here)
# Copy to backend/.env for local development

# Deployment & Server
ENVIRONMENT=development
PORT=8000

# CORS / Allowed Frontend URLs:
# Set this to your production Vercel frontend URL when deploying to Render
# Example: FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Default uses local SQLite; use PostgreSQL in production if desired)
DATABASE_URL=sqlite:///./codespace.db

# Authentication / JWT
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Coding Assistant (OpenRouter or Google Gemini)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
AI_API_KEY=
AI_PROVIDER=auto
AI_MODEL=openai/gpt-4o-mini

# Code Execution Providers ('local', 'piston', 'judge0', or 'auto')
EXECUTION_PROVIDER=local
PISTON_API_URL=https://emkc.org/api/v2/piston
JUDGE0_API_URL=https://ce.judge0.com/submissions?wait=true&base64_encoded=true

# WebRTC STUN
STUN_SERVER=stun:stun.l.google.com:19302
