# Frontend Environment Configuration Template (DO NOT put real secrets here)
# Copy to frontend/.env.local for local testing or configure in Vercel Project Settings

# Render Backend URL for Production (e.g., https://your-backend-app.onrender.com)
# In local development, leave this empty to use Vite's built-in /api and /ws proxy.
VITE_API_URL=https://your-backend-app.onrender.com

# (Optional) Explicit WebSocket URL if different from VITE_API_URL
# If omitted, the frontend automatically derives wss:// from VITE_API_URL
# VITE_WS_URL=wss://your-backend-app.onrender.com
